# Copy this file to secrets.env before deploying. Never commit secrets.env.
# The deploy scripts do this automatically for local demos.
MONGO_ROOT_USERNAME=streamvault
MONGO_ROOT_PASSWORD=streamvault_root_password
MONGO_APP_USERNAME=streamvault_app
MONGO_APP_PASSWORD=streamvault_dev_password
MONGODB_URI=mongodb://streamvault_app:streamvault_dev_password@mongo:27017/streamvault?authSource=streamvault
