# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
INSTANCE_ID=local-dev

# MongoDB (also stores video bytes in GridFS)
MONGODB_URI=mongodb://streamvault_app:streamvault_dev_password@localhost:27017/streamvault?authSource=streamvault
MONGODB_DB=streamvault
MEDIA_BUCKET=media

# Uploads
UPLOAD_TMP_DIR=/tmp/streamvault-uploads
MAX_UPLOAD_BYTES=209715200
