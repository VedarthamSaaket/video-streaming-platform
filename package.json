{
  "name": "streamvault",
  "version": "1.0.0",
  "private": true,
  "description": "StreamVault - a containerised video streaming platform with MongoDB, NGINX load balancing and Kubernetes autoscaling",
  "keywords": [
    "video-streaming",
    "kubernetes",
    "nginx",
    "docker",
    "mongodb",
    "autoscaling",
    "devops"
  ],
  "license": "MIT",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint .",
    "load": "node scripts/load-test.js",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongodb": "^6.12.0",
    "mongoose": "^8.9.2",
    "multer": "^2.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "autocannon": "^8.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  }
}
